<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by every extension; the values come from its extension.json
     (buildSrc/src/main/kotlin/dramas.extension.gradle.kts). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="tachiyomi.animeextension" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appName}">

        <meta-data
            android:name="tachiyomi.animeextension.class"
            android:value="${extClass}" />
        <meta-data
            android:name="tachiyomi.animeextension.nsfw"
            android:value="${nsfw}" />
    </application>
</manifest>
